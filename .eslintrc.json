{
  "env": {
    "es6": true,
    "node": true,
    "jest/globals": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-use-before-define": "off",
    "no-plusplus": "off",
    "no-shadow": "off",
    "import/prefer-default-export": "off"
  },
  "extends": ["eslint:recommended", "airbnb-base", "prettier"],
  "ignorePatterns": ["node_modules/", "dist/", "build/"]
}
